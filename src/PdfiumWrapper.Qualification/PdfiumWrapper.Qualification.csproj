<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Qualification harness for PdfiumWrapper.Processing: a 10,000-job burst and a 30-minute soak
    against a pool whose workers are copies of this executable. Not packed, not a test project:
    run it by hand on a machine we control (Windows natively, Linux in Docker), not on
    shared CI runners. See ai/plans/plan-pool-qualification.md. Program.cs lists the modes and options (an XML comment
    cannot hold the double-dash command line).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfiumWrapper\PdfiumWrapper.csproj" />
    <ProjectReference Include="..\PdfiumWrapper.Processing\PdfiumWrapper.Processing.csproj" />
  </ItemGroup>

  <!-- The same corpus as the tests and benchmarks. -->
  <ItemGroup>
    <Content Include="..\PdfiumWrapper.Tests\Docs\*.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Docs\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
