<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Head-to-head benchmarks against other PDF engines (Ghostscript, Aspose.PDF).
    Opt-in: this project is deliberately not part of PdfiumWrapper.sln, so the solution build and
    CI do not restore a commercial package. Run it from this directory:

      dotnet run -c Release

    Ghostscript is found on PATH or through GHOSTSCRIPT_EXE. Aspose.PDF needs a license file,
    named by ASPOSE_PDF_LICENSE. Never copy a license file into this repository.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="Aspose.PDF" Version="25.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfiumWrapper\PdfiumWrapper.csproj" />
  </ItemGroup>

  <!-- The same corpus as PdfiumWrapper.Benchmarks. -->
  <ItemGroup>
    <Content Include="..\PdfiumWrapper.Tests\Docs\*.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Docs\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
