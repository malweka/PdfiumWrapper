<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
		<FileVersion>1.0.0.0</FileVersion>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<Authors>Emmanuel Hameyie</Authors>
		<Copyright>Copyright © 2025 Emmanuel Hameyie</Copyright>
		<PackageId>PdfiumWrapper</PackageId>
		<Product>PdfiumWrapper</Product>
		<Title>PdfiumWrapper</Title>
		<Description>Cross-platform .NET 8 wrapper around Google's PDFium engine for rendering, manipulating, editing, and form-filling PDF documents. Native binaries for Windows (x64), Linux (x64), and macOS (x64 and Arm64) are bundled in the package, so no separate native setup is required. Supports rasterizing pages to PNG, JPEG, and multi-page TIFF.</Description>
		<PackageTags>pdf;pdfium;pdf-manipulation;pdf-rendering;pdf-editing;pdf-forms;cross-platform;native</PackageTags>
		<RepositoryUrl>https://github.com/malweka/PdfiumWrapper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/malweka/PdfiumWrapper</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<!-- SourceLink, deterministic build, and symbol package (.snupkg) settings -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PdfiumWrapper.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

	<!-- Platform detection fallbacks when NativeRid/NativeLibName not provided (drives local dev copy-to-output) -->
	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">
		<NativeRid>win-x64</NativeRid>
		<NativeLibName>pdfium.dll</NativeLibName>
		<TiffLibName>tiff.dll</TiffLibName>
		<TiffShimLibName>tiff_shim.dll</TiffShimLibName>
		<TurboJpegLibName>turbojpeg.dll</TurboJpegLibName>
		<PdfiumPngLibName>pdfium_png.dll</PdfiumPngLibName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
		<NativeRid>osx-arm64</NativeRid>
		<NativeLibName>libpdfium.dylib</NativeLibName>
		<TiffLibName>libtiff.dylib</TiffLibName>
		<TiffShimLibName>libtiff_shim.dylib</TiffShimLibName>
		<TurboJpegLibName>libturbojpeg.dylib</TurboJpegLibName>
		<PdfiumPngLibName>libpdfium_png.dylib</PdfiumPngLibName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
		<NativeRid>osx-x64</NativeRid>
		<NativeLibName>libpdfium.dylib</NativeLibName>
		<TiffLibName>libtiff.dylib</TiffLibName>
		<TiffShimLibName>libtiff_shim.dylib</TiffShimLibName>
		<TurboJpegLibName>libturbojpeg.dylib</TurboJpegLibName>
		<PdfiumPngLibName>libpdfium_png.dylib</PdfiumPngLibName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">
		<NativeRid>linux-x64</NativeRid>
		<NativeLibName>libpdfium.so</NativeLibName>
		<TiffLibName>libtiff.so</TiffLibName>
		<TiffShimLibName>libtiff_shim.so</TiffShimLibName>
		<TurboJpegLibName>libturbojpeg.so</TurboJpegLibName>
		<PdfiumPngLibName>libpdfium_png.so</PdfiumPngLibName>
	</PropertyGroup>

	<!-- Include README and icon in package -->
	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="\" />
		<None Include="../../icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Generate runtime.json mapping each RID to its PdfiumWrapper.runtime.<rid>
	     package at the current version, and pack it at the package root. NuGet uses
	     this to pull ONLY the consumer's-platform native package at restore time. -->
	<Target Name="GenerateRuntimeJson" BeforeTargets="GenerateNuspec;_GetPackageFiles;Build">
		<PropertyGroup>
			<_RuntimeJson>{ &quot;runtimes&quot;: { &quot;win-x64&quot;: { &quot;PdfiumWrapper&quot;: { &quot;PdfiumWrapper.runtime.win-x64&quot;: &quot;$(Version)&quot; } }, &quot;linux-x64&quot;: { &quot;PdfiumWrapper&quot;: { &quot;PdfiumWrapper.runtime.linux-x64&quot;: &quot;$(Version)&quot; } }, &quot;osx-x64&quot;: { &quot;PdfiumWrapper&quot;: { &quot;PdfiumWrapper.runtime.osx-x64&quot;: &quot;$(Version)&quot; } }, &quot;osx-arm64&quot;: { &quot;PdfiumWrapper&quot;: { &quot;PdfiumWrapper.runtime.osx-arm64&quot;: &quot;$(Version)&quot; } } } }</_RuntimeJson>
		</PropertyGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)runtime.json" Lines="$(_RuntimeJson)" Overwrite="true" />
	</Target>
	<ItemGroup>
		<None Include="$(IntermediateOutputPath)runtime.json" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<!-- Native libs copied to output for local dev/test only (Pack=false; the
	     PdfiumWrapper.runtime.<rid> packages carry the natives in the published package). -->
	<ItemGroup Condition="'$(NativeRid)' != ''">
		<Content Include="../libs/$(NativeRid)/$(NativeLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(NativeLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(TiffLibName)' != '' And Exists('../libs/$(NativeRid)/$(TiffLibName)')">
		<Content Include="../libs/$(NativeRid)/$(TiffLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(TiffLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(TiffShimLibName)' != '' And Exists('../libs/$(NativeRid)/$(TiffShimLibName)')">
		<Content Include="../libs/$(NativeRid)/$(TiffShimLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(TiffShimLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(TurboJpegLibName)' != '' And Exists('../libs/$(NativeRid)/$(TurboJpegLibName)')">
		<Content Include="../libs/$(NativeRid)/$(TurboJpegLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(TurboJpegLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(PdfiumPngLibName)' != '' And Exists('../libs/$(NativeRid)/$(PdfiumPngLibName)')">
		<Content Include="../libs/$(NativeRid)/$(PdfiumPngLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(PdfiumPngLibName)</TargetPath>
		</Content>
	</ItemGroup>

</Project>
