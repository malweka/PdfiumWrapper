<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<Version>2.0.0</Version>
		<FileVersion>2.0.0.0</FileVersion>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<Authors>Emmanuel Hameyie</Authors>
		<Copyright>Copyright © 2025 Emmanuel Hameyie</Copyright>
		<PackageId>PdfiumWrapper</PackageId>
		<Product>PdfiumWrapper</Product>
		<Title>PdfiumWrapper</Title>
		<Description>Cross-platform .NET 10 wrapper around Google's PDFium engine for rendering, manipulating, editing, and form-filling PDF documents. Native binaries for Windows (x64), Linux (x64), and macOS (x64 and Arm64) are bundled in the package, so no separate native setup is required. Supports rasterizing pages to PNG, JPEG, and multi-page TIFF.</Description>
		<PackageTags>pdf;pdfium;pdf-manipulation;pdf-rendering;pdf-editing;pdf-forms;cross-platform;native</PackageTags>
		<RepositoryUrl>https://github.com/malweka/PdfiumWrapper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/malweka/PdfiumWrapper</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<!-- SourceLink, deterministic build, and symbol package (.snupkg) settings -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PdfiumWrapper.Tests" />
		<InternalsVisibleTo Include="PdfiumWrapper.Tests.Host" />
		<InternalsVisibleTo Include="PdfiumWrapper.Processing" />
		<InternalsVisibleTo Include="PdfiumWrapper.Benchmarks" />
	</ItemGroup>

	<!-- Platform detection fallbacks when NativeRid/NativeLibName not provided (drives local dev copy-to-output) -->
	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">
		<NativeRid>win-x64</NativeRid>
		<NativeLibName>pdfium.dll</NativeLibName>
		<TiffLibName>tiff.dll</TiffLibName>
		<TiffShimLibName>tiff_shim.dll</TiffShimLibName>
		<TurboJpegLibName>turbojpeg.dll</TurboJpegLibName>
		<PdfiumPngLibName>pdfium_png.dll</PdfiumPngLibName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
		<NativeRid>osx-arm64</NativeRid>
		<NativeLibName>libpdfium.dylib</NativeLibName>
		<TiffLibName>libtiff.dylib</TiffLibName>
		<TiffShimLibName>libtiff_shim.dylib</TiffShimLibName>
		<TurboJpegLibName>libturbojpeg.dylib</TurboJpegLibName>
		<PdfiumPngLibName>libpdfium_png.dylib</PdfiumPngLibName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
		<NativeRid>osx-x64</NativeRid>
		<NativeLibName>libpdfium.dylib</NativeLibName>
		<TiffLibName>libtiff.dylib</TiffLibName>
		<TiffShimLibName>libtiff_shim.dylib</TiffShimLibName>
		<TurboJpegLibName>libturbojpeg.dylib</TurboJpegLibName>
		<PdfiumPngLibName>libpdfium_png.dylib</PdfiumPngLibName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(NativeRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">
		<NativeRid>linux-x64</NativeRid>
		<NativeLibName>libpdfium.so</NativeLibName>
		<TiffLibName>libtiff.so</TiffLibName>
		<TiffShimLibName>libtiff_shim.so</TiffShimLibName>
		<TurboJpegLibName>libturbojpeg.so</TurboJpegLibName>
		<PdfiumPngLibName>libpdfium_png.so</PdfiumPngLibName>
	</PropertyGroup>

	<!-- Include README, icon and the third-party notices for the natives in package -->
	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="\" />
		<None Include="../../icon.png" Pack="true" PackagePath="\" />
		<None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!--
		Native binaries ship in the four PdfiumWrapper.runtime.<rid> packages, which this package
		depends on at exactly its own version. Each puts its files under runtimes/<rid>/native, so a
		portable build (no RuntimeIdentifier) gets every platform and the host picks the right one,
		and a RID-specific publish copies only its own. A runtime.json mapping was used before, but
		NuGet applies it only to RID-specific restores, so portable apps got no natives at all.

		The runtime packages exist only once the release workflow has packed them, so the references
		apply only when PackRuntimeDependencies=true (restored from that workflow's artifacts). Any
		other pack of this project produces a package without natives, for inspection only.
	-->
	<ItemGroup Condition="'$(PackRuntimeDependencies)' == 'true'">
		<PackageReference Include="PdfiumWrapper.runtime.win-x64" Version="[$(Version)]" />
		<PackageReference Include="PdfiumWrapper.runtime.linux-x64" Version="[$(Version)]" />
		<PackageReference Include="PdfiumWrapper.runtime.osx-x64" Version="[$(Version)]" />
		<PackageReference Include="PdfiumWrapper.runtime.osx-arm64" Version="[$(Version)]" />
	</ItemGroup>
	<Target Name="WarnPackWithoutNatives" BeforeTargets="GenerateNuspec" Condition="'$(PackRuntimeDependencies)' != 'true'">
		<Warning Text="Packing PdfiumWrapper without its native runtime packages (PackRuntimeDependencies is not true): this package cannot run. Only the release workflow produces a usable package." />
	</Target>

	<!-- Native libs copied to output for local dev/test only (Pack=false; the
	     PdfiumWrapper.runtime.<rid> packages carry the natives in the published package). -->
	<ItemGroup Condition="'$(NativeRid)' != ''">
		<Content Include="../libs/$(NativeRid)/$(NativeLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(NativeLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(TiffLibName)' != '' And Exists('../libs/$(NativeRid)/$(TiffLibName)')">
		<Content Include="../libs/$(NativeRid)/$(TiffLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(TiffLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(TiffShimLibName)' != '' And Exists('../libs/$(NativeRid)/$(TiffShimLibName)')">
		<Content Include="../libs/$(NativeRid)/$(TiffShimLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(TiffShimLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(TurboJpegLibName)' != '' And Exists('../libs/$(NativeRid)/$(TurboJpegLibName)')">
		<Content Include="../libs/$(NativeRid)/$(TurboJpegLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(TurboJpegLibName)</TargetPath>
		</Content>
	</ItemGroup>

	<ItemGroup Condition="'$(NativeRid)' != '' And '$(PdfiumPngLibName)' != '' And Exists('../libs/$(NativeRid)/$(PdfiumPngLibName)')">
		<Content Include="../libs/$(NativeRid)/$(PdfiumPngLibName)">
			<Pack>false</Pack>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>runtimes/$(NativeRid)/native/$(PdfiumPngLibName)</TargetPath>
		</Content>
	</ItemGroup>

</Project>
